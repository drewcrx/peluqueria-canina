{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // ConnectionStrings y Jwt viven en "dotnet user-secrets" (fuera de git a propósito, ver
  // README) — nunca deben volver a escribirse aquí en texto plano. Corre esto una vez por
  // máquina de desarrollo:
  //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5433;Database=peluqueria_saas;Username=peluqueria;Password=peluqueria_dev_password"
  //   dotnet user-secrets set "Jwt:Issuer" "PeluqueriaSaas"
  //   dotnet user-secrets set "Jwt:Audience" "PeluqueriaSaas.Clients"
  //   dotnet user-secrets set "Jwt:SigningKey" "<genera uno propio, ej. openssl rand -base64 48>"
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
